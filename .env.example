# 复制为 .env 后按需修改

# 对外访问地址（部署到公网时改成你的域名，如 https://pay.example.com）
PUBLIC_BASE_URL=http://localhost
HTTP_PORT=80

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=bigbear_fastpay
MYSQL_USER=fastpay
MYSQL_PASSWORD=change-me

# 后端
JWT_SECRET=change-me-to-a-long-random-jwt-secret

# 对接 Demo（可选，仅 --profile demo 时生效；留空使用仓库内的演示商户）
# DEMO_MERCHANT_NO=
# DEMO_SHOP_NO=
# DEMO_API_SECRET=
